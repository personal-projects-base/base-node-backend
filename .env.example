NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Pipeline HTTP global.
REQUEST_LOG_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Quantidade de proxies reversos confiáveis entre o cliente e a API. Use 0 sem proxy.
TRUST_PROXY_HOPS=0

# Persistência padrão utilizada pelo CRUD gerado pelo Gonthera/Prisma.
# MongoDB precisa operar como replica set porque os repositories usam transações.
DATABASE_URL="mongodb://localhost:27017/base_node?replicaSet=rs0&directConnection=true"

# No MongoDB use "push"; no PostgreSQL use "migrate".
PRISMA_DEPLOY_MODE=push

# Pool PostgreSQL nativo opcional para consultas específicas da aplicação.
POSTGRES_NATIVE_ENABLED=false
POSTGRES_URL="postgresql://base_node:troque_esta_senha@localhost:5432/base_node?schema=public"
POSTGRES_POOL_MAX=10

# Cliente MongoDB nativo opcional para módulos customizados. O CRUD gerado usa Prisma.
MONGODB_ENABLED=false
MONGODB_URL="mongodb://localhost:27017/base_node?replicaSet=rs0&directConnection=true"
MONGODB_DATABASE="base_node"
MONGODB_MAX_POOL_SIZE=10

RABBITMQ_ENABLED=false
RABBITMQ_URL="amqp://base_node:base_node_change_me@localhost:5672"
RABBITMQ_EXCHANGE="base.node.events"
RABBITMQ_REQUEUE_ON_ERROR=false
