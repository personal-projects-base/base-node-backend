NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Persistência utilizada pelo CRUD gerado pelo Gonthera/Prisma.
DATABASE_URL="postgresql://base_node:base_node_change_me@localhost:5432/base_node?schema=public"

# Pool PostgreSQL nativo opcional para consultas específicas da aplicação.
POSTGRES_NATIVE_ENABLED=false
POSTGRES_POOL_MAX=10

# MongoDB opcional para módulos customizados. O CRUD gerado continua no Prisma/PostgreSQL.
MONGODB_ENABLED=false
MONGODB_URL="mongodb://base_node:base_node_change_me@localhost:27017/base_node?authSource=admin"
MONGODB_DATABASE="base_node"
MONGODB_MAX_POOL_SIZE=10

RABBITMQ_ENABLED=false
RABBITMQ_URL="amqp://base_node:base_node_change_me@localhost:5672"
RABBITMQ_EXCHANGE="base.node.events"
RABBITMQ_REQUEUE_ON_ERROR=false
